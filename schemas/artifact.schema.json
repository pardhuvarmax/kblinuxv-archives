{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^LVA-\\d{4}-\\d{4,}-\\d{3,}$"
    },
    "cve": {
      "type": "string",
      "pattern": "^CVE-\\d{4}-\\d{4,}$"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "exploit_poc",
            "functional_reproducer",
            "crash_reproducer",
            "kernel_reproducer",
            "poc_test",
            "patch_reference",
            "technical_analysis",
            "vendor_advisory",
            "other"
          ]
        },
        "filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": "string"
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "discovery": {
      "type": "object"
    },
    "verification": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "DISCOVERED",
            "RETRIEVED",
            "SOURCE_REVIEWED",
            "LAB_VALIDATED",
            "REJECTED"
          ]
        },
        "source_reviewed": {
          "type": "boolean"
        },
        "lab_validated": {
          "type": "boolean"
        }
      }
    },
    "redistribution": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "approved",
            "restricted",
            "unknown",
            "reference-only",
            "pending"
          ]
        }
      }
    }
  },
  "required": [
    "artifact_id",
    "cve",
    "artifact"
  ]
}
