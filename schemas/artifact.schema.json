{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^LVA-\\d{4}-\\d{4,}-\\d{3,}$"
    },
    "cve": {
      "type": "string",
      "pattern": "^CVE-\\d{4}-\\d{4,}$"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "exploit_poc",
            "functional_reproducer",
            "crash_reproducer",
            "kernel_reproducer",
            "poc_test",
            "patch_reference",
            "technical_analysis",
            "vendor_advisory",
            "other"
          ]
        },
        "filename": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "artifact_id",
    "cve",
    "artifact"
  ]
}
