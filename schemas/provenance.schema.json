{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provenance",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "original_author": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "artifact_id"
  ]
}
